use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests
	- bin/neon-lint

excludePaths:
	- tests/neon-spec

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations
